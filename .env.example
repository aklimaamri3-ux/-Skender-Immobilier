# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER expose to the client, never commit real values.
# Used only in server actions / route handlers that need elevated access
# (e.g. creating the very first admin). Leave empty if not needed locally.
SUPABASE_SERVICE_ROLE_KEY=
